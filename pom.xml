<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父工程：统一管理 Spring Boot 版本（见 ADR-0001）。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>

    <groupId>dev.javaagentstudy</groupId>
    <artifactId>java-agent-study</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <!-- packaging 为 pom 表示这是一个只负责聚合子模块的父工程，自身不产出代码。 -->
    <packaging>pom</packaging>
    <name>JavaAgentStudy</name>

    <!-- 子模块列表（见 ADR-0002）。后续阶段模块会在这里逐个追加。 -->
    <modules>
        <module>common</module>
        <module>stage-01-chat-and-structured-output</module>
    </modules>

    <properties>
        <!-- 默认排除带 live-llm 标签的真实大模型测试；需要时用 -Dsurefire.excludedGroups= 覆盖。 -->
        <surefire.excludedGroups>live-llm</surefire.excludedGroups>
        <java.version>21</java.version>
        <spring-ai.version>2.1.0</spring-ai.version>
    </properties>

    <!-- 只声明版本，不会真的引入依赖；子模块需要时再按需引用。 -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM：统一管理所有 spring-ai-* 依赖的版本。 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 让 stage 模块可以用统一版本引用 common。 -->
            <dependency>
                <groupId>dev.javaagentstudy</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- 默认 mvn test 排除真实大模型测试，保证离线、零费用。
                             需要时用 -Dsurefire.excludedGroups= 覆盖后再运行。 -->
                        <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
