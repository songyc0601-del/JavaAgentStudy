<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父工程：统一管理 Spring Boot 版本（见 ADR-0001）。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>

    <groupId>dev.javaagentstudy</groupId>
    <artifactId>java-agent-study</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <!-- packaging 为 pom 表示这是一个只负责聚合子模块的父工程，自身不产出代码。 -->
    <packaging>pom</packaging>
    <name>JavaAgentStudy</name>

    <!-- 子模块列表（见 ADR-0002）。后续阶段模块会在这里逐个追加。 -->
    <modules>
        <module>common</module>
        <module>stage-01-chat-and-structured-output</module>
    </modules>

    <properties>
        <!-- 默认排除带 live-llm 标签的真实大模型测试；需要时用 -Plive-llm Profile 运行。 -->
        <surefire.excludedGroups>live-llm</surefire.excludedGroups>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>21</java.version>
        <spring-ai.version>2.1.0</spring-ai.version>
        <!-- Spring Boot 4.x 对应 springdoc-openapi 3.x 分支。 -->
        <springdoc-openapi.version>3.2.1</springdoc-openapi.version>
        <!-- 静态护栏版本统一管理：Checkstyle 与 ArchUnit。 -->
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>10.21.4</checkstyle.version>
        <archunit.version>1.4.1</archunit.version>
    </properties>

    <!-- 只声明版本，不会真的引入依赖；子模块需要时再按需引用。 -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM：统一管理所有 spring-ai-* 依赖的版本。 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 让 stage 模块可以用统一版本引用 common。 -->
            <dependency>
                <groupId>dev.javaagentstudy</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- OpenAPI 3 / Swagger UI（WebMVC Starter），供有 HTTP 接口的阶段模块按需引入。 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <!-- ArchUnit：在单测阶段自动验证模块内包边界与无循环依赖。 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 静态护栏：随默认 mvn test 自动执行，禁止 Jackson 2 databind、Spring AI 旧弃用 API 及脏导入。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-validate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- 默认 mvn test 排除真实大模型测试，保证离线、零费用。
                             需要运行真实模型端到端测试时，请显式激活 -Plive-llm Profile。 -->
                        <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- 显式运行带 @Tag("live-llm") 的真实大模型端到端测试：mvn -B -ntp -Plive-llm test
             自动清空 excludedGroups、只运行 live-llm 分组，并排除故意必败的守卫测试 LiveLlmExclusionGuardTest。 -->
        <profile>
            <id>live-llm</id>
            <properties>
                <surefire.excludedGroups/>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludedGroups/>
                            <groups>live-llm</groups>
                            <excludes>
                                <exclude>**/LiveLlmExclusionGuardTest.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
