<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  轻量级确定性静态护栏：只放机械可判定的规则（禁用旧版 API、导入卫生），
  判断类规范统一留在根目录 CODING_STANDARDS.md 由 Review Agent 负责。
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="TreeWalker">
        <!--
          1. 禁用 Jackson 2 databind（Spring Boot 4.2 / Spring AI 2.1 基线统一用 tools.jackson.databind；
             注意 jackson-annotations 仍位于 com.fasterxml.jackson.annotation，故不禁用顶层包）。
          2. 禁用 Spring AI 2.x 已弃用或移除的旧 API，避免教程惯性回流。
        -->
        <module name="IllegalImport">
            <property name="illegalPkgs" value="com.fasterxml.jackson.databind"/>
            <property name="illegalClasses"
                      value="org.springframework.ai.chat.memory.ChatMemory,org.springframework.ai.chat.memory.MessageWindowChatMemory,org.springframework.ai.chat.client.advisor.MessageChatMemoryAdvisor,org.springframework.ai.chat.client.advisor.PromptChatMemoryAdvisor,org.springframework.ai.chat.client.advisor.ToolCallAdvisor,org.springframework.ai.model.function.FunctionCallback"/>
        </module>

        <!-- 导入卫生：禁止通配符导入、未用导入与冗余导入。 -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
    </module>
</module>
